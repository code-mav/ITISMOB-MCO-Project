<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <!-- Scrollable content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <!-- Logo -->
            <ImageView
                android:id="@+id/logoIv"
                android:layout_width="70dp"
                android:layout_height="70dp"
                android:layout_marginTop="24dp"
                android:src="@drawable/snapbit"
                android:contentDescription="@string/app_logo"
                android:scaleType="fitCenter" />

            <!-- App title -->
            <TextView
                android:id="@+id/appTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/title"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="8dp" />

            <!-- Subtitle -->
            <TextView
                android:id="@+id/appSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/subtitle"
                android:textSize="14sp"
                android:gravity="center"
                android:textColor="#666666"
                android:layout_marginTop="-8dp"
                android:layout_marginBottom="20dp" />

            <!-- Category cards -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="16dp">

                <!-- ===== CATEGORY CARD TEMPLATE ===== -->

                <!-- FITNESS -->
                <LinearLayout
                    android:id="@+id/layout_cat_fitness"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/habit_box_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_streak"
                        android:layout_marginEnd="6dp"
                        android:adjustViewBounds="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_cat_fitness_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Fitness"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/text_cat_fitness_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Streak: 0"
                            android:textSize="12sp"
                            android:textColor="#666666" />
                    </LinearLayout>
                </LinearLayout>

                <!-- LEARNING -->
                <LinearLayout
                    android:id="@+id/layout_cat_learning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/habit_box_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_streak"
                        android:layout_marginEnd="6dp"
                        android:adjustViewBounds="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_cat_learning_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Learning"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/text_cat_learning_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Streak: 0"
                            android:textSize="12sp"
                            android:textColor="#666666" />
                    </LinearLayout>
                </LinearLayout>

                <!-- HEALTH -->
                <LinearLayout
                    android:id="@+id/layout_cat_health"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/habit_box_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_streak"
                        android:layout_marginEnd="6dp"
                        android:adjustViewBounds="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_cat_health_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Health"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/text_cat_health_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Streak: 0"
                            android:textSize="12sp"
                            android:textColor="#666666" />
                    </LinearLayout>
                </LinearLayout>

                <!-- CREATIVITY -->
                <LinearLayout
                    android:id="@+id/layout_cat_creativity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/habit_box_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_streak"
                        android:layout_marginEnd="6dp"
                        android:adjustViewBounds="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_cat_creativity_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Creativity"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/text_cat_creativity_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Streak: 0"
                            android:textSize="12sp"
                            android:textColor="#666666" />
                    </LinearLayout>
                </LinearLayout>

                <!-- PRODUCTIVITY -->
                <LinearLayout
                    android:id="@+id/layout_cat_productivity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/habit_box_bg"
                    android:padding="12dp"
                    android:layout_marginBottom="10dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_streak"
                        android:layout_marginEnd="6dp"
                        android:adjustViewBounds="true" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/text_cat_productivity_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Productivity"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:textColor="#333333" />

                        <TextView
                            android:id="@+id/text_cat_productivity_streak"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Streak: 0"
                            android:textSize="12sp"
                            android:textColor="#666666" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Custom Title Field -->
            <EditText
                android:id="@+id/edittext_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Add a title for today's snap"
                android:textSize="14sp"
                android:padding="10dp"
                android:background="@android:drawable/editbox_background"
                android:layout_marginBottom="16dp" />

            <!-- Submit Proof Button -->
            <Button
                android:id="@+id/submitProofBtn"
                android:layout_width="180dp"
                android:layout_height="48dp"
                android:text="Submit Proof"
                android:textAllCaps="false"
                android:textSize="15sp"
                android:backgroundTint="?attr/colorPrimary"
                android:textColor="@android:color/white"
                android:elevation="2dp" />

        </LinearLayout>
    </ScrollView>

    <!-- Info FAB -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/infoFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="110dp"
        android:contentDescription="About SnapBit"
        android:src="@android:drawable/ic_menu_info_details"
        app:backgroundTint="?attr/colorPrimary"
        app:tint="@android:color/white"
        android:elevation="6dp"
        android:layout_gravity="bottom|end" />

</FrameLayout>
